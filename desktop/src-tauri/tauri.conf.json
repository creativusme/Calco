{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calco",
  "version": "1.0.0",
  "identifier": "app.calco.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Calco", "width": 1360, "height": 860, "minWidth": 1000, "minHeight": 640 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Calco",
    "shortDescription": "3D scanning: iPhone capture, local reconstruction",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": { "runtime/": "runtime/" },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
